# ============================================================
#  模型服务配置（首次使用必填！）
#  需要填三样东西：接口地址 LLM_BASE_URL / 密钥 LLM_API_KEY / 模型名 LLM_MODEL
#  用法：把本文件复制一份重命名为 .env，改掉等号右边即可
# ============================================================
#
# ▶ 密钥哪里来？
#   去你选择的厂商开放平台注册并创建API key，例如：
#   智谱 https://open.bigmodel.cn ｜ DeepSeek https://platform.deepseek.com
#   Kimi https://platform.moonshot.cn ｜ 通义 https://dashscope.console.aliyun.com
#   OpenAI https://platform.openai.com
#
# ▶ 怎么用这个文件？
#   把本文件复制一份，重命名为 .env（注意开头有个点），填入下面三项。
#
#   macOS/Linux:  cp .env.example .env
#   Windows(cmd): copy .env.example .env
#
# ▶ 为什么不直接建 .env？
#   .env 已被 .gitignore 排除，不会被上传到 GitHub——你的密钥
#   只留在自己电脑上。仓库里只放这个不含真实密钥的模板。
#
# ────────────────────────────────────────────────────────────
# 1. 对话模型（必填三项）
# ────────────────────────────────────────────────────────────

# 接口地址：用哪家就填哪家的地址（常用示例见下方"厂商速查"）
LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 接口协议：anthropic 或 openai（看你选的厂商用哪种，速查表里已标明）
LLM_API_TYPE=anthropic

# 你的API密钥（去厂商控制台复制）
LLM_API_KEY=在这里填入你的API密钥

# 模型名（用哪家就填哪家的模型）
LLM_MODEL=glm-5.3-flash

# （可选）单次回复的token上限，默认16384。智谱GLM需要给足余量；
# 若其他厂商报 max_tokens 超限错误，改成 8192 试试
# LLM_MAX_TOKENS=16384

# ────────────────────────────────────────────────────────────
# 2. 厂商速查（填上面三项时对照；删除行首#并改成你的值即可切换）
# ────────────────────────────────────────────────────────────

# 智谱GLM（默认）：
#   LLM_API_TYPE=anthropic
#   LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   LLM_MODEL=glm-5.3-flash

# DeepSeek：
#   LLM_API_TYPE=openai
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat

# Kimi（月之暗面）：
#   LLM_API_TYPE=openai
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-32k

# 通义千问：
#   LLM_API_TYPE=openai
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus

# OpenAI：
#   LLM_API_TYPE=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini

# ⚠️ 注意：LLM_BASE_URL 必须是 OpenAI 兼容 或 Anthropic 兼容 接口，
# 大多数国内外厂商两种都有，控制台文档里找"接口地址/base_url"即可。

# ────────────────────────────────────────────────────────────
# 3. Embedding模型（用于文献入库和检索；默认智谱，可以不换）
# ────────────────────────────────────────────────────────────

# 如果对话模型用的不是智谱，Embedding有两个选择：
#   a) 继续用智谱的embedding（保留默认即可，但 EMBEDDING_API_KEY 要填智谱的密钥）；
#   b) 用对话模型同厂商的embedding（改这三项，且密钥不变时 EMBEDDING_API_KEY 可省略）。
# 注意：DeepSeek 没有embedding接口，选a并在EMBEDDING_API_KEY填智谱密钥。

EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# 与对话模型不同厂商/不同密钥时才需要填：
# EMBEDDING_API_KEY=在这里填embedding服务的密钥
